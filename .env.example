# AIO診断で問い合わせる各AIのAPIキー。設定したプロバイダだけが診断に使われます。
# クラウド環境ではネットワークシークレット（プロキシ注入）として保存するため、
# ここにはダミー値を置いてもかまいません。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# 任意: 使用モデルの上書き
# AIO_ANTHROPIC_MODEL=claude-opus-5-5
# AIO_OPENAI_MODEL=gpt-5
# AIO_GEMINI_MODEL=gemini-2.5-flash
# AIO_PERPLEXITY_MODEL=sonar

# 任意: レポートの出力先ディレクトリ（既定: ./reports）
# AIO_REPORT_DIR=./reports
